{
  "name": "baymax-protocol",
  "version": 2,
  "minSupportedVersion": 1,
  "maxMessageBytes": 65536,
  "characterStates": [
    "IDLE",
    "LISTENING",
    "THINKING",
    "SPEAKING",
    "EXECUTING",
    "SUCCESS",
    "CONFUSED",
    "CONCERNED",
    "SLEEPING",
    "ERROR",
    "DISCONNECTED"
  ],
  "characterTransitions": {
    "IDLE": [
      "LISTENING",
      "THINKING",
      "SPEAKING",
      "EXECUTING",
      "CONFUSED",
      "CONCERNED",
      "SLEEPING",
      "ERROR",
      "DISCONNECTED"
    ],
    "LISTENING": [
      "IDLE",
      "THINKING",
      "SLEEPING",
      "ERROR",
      "DISCONNECTED"
    ],
    "THINKING": [
      "IDLE",
      "LISTENING",
      "SPEAKING",
      "EXECUTING",
      "CONFUSED",
      "CONCERNED",
      "SLEEPING",
      "ERROR",
      "DISCONNECTED"
    ],
    "SPEAKING": [
      "IDLE",
      "LISTENING",
      "THINKING",
      "EXECUTING",
      "CONFUSED",
      "CONCERNED",
      "SLEEPING",
      "ERROR",
      "DISCONNECTED"
    ],
    "EXECUTING": [
      "IDLE",
      "THINKING",
      "SPEAKING",
      "SUCCESS",
      "CONFUSED",
      "CONCERNED",
      "SLEEPING",
      "ERROR",
      "DISCONNECTED"
    ],
    "SUCCESS": [
      "IDLE",
      "LISTENING",
      "THINKING",
      "SPEAKING",
      "EXECUTING",
      "CONFUSED",
      "CONCERNED",
      "SLEEPING",
      "ERROR",
      "DISCONNECTED"
    ],
    "CONFUSED": [
      "IDLE",
      "LISTENING",
      "THINKING",
      "SPEAKING",
      "EXECUTING",
      "CONCERNED",
      "SLEEPING",
      "ERROR",
      "DISCONNECTED"
    ],
    "CONCERNED": [
      "IDLE",
      "LISTENING",
      "THINKING",
      "SPEAKING",
      "EXECUTING",
      "CONFUSED",
      "SLEEPING",
      "ERROR",
      "DISCONNECTED"
    ],
    "SLEEPING": [
      "IDLE",
      "DISCONNECTED"
    ],
    "ERROR": [
      "IDLE",
      "LISTENING",
      "THINKING",
      "SPEAKING",
      "EXECUTING",
      "CONFUSED",
      "CONCERNED",
      "SLEEPING",
      "DISCONNECTED"
    ],
    "DISCONNECTED": [
      "IDLE",
      "SLEEPING"
    ]
  },
  "characterEvents": {
    "MIC_STARTED": "LISTENING",
    "MIC_STOPPED": "IDLE",
    "REQUEST_RECEIVED": "THINKING",
    "SPEECH_STARTED": "SPEAKING",
    "SPEECH_ENDED": "IDLE",
    "TASK_STARTED": "EXECUTING",
    "TASK_VERIFIED": "SUCCESS",
    "TASK_FAILED": "ERROR",
    "TASK_CANCELLED": "IDLE",
    "CLARIFICATION_NEEDED": "CONFUSED",
    "WARNING_RAISED": "CONCERNED",
    "APPROVAL_REQUIRED": "CONCERNED",
    "SLEEP": "SLEEPING",
    "WAKE": "IDLE",
    "CONNECTION_LOST": "DISCONNECTED",
    "CONNECTION_RESTORED": "IDLE",
    "RESET": "IDLE"
  },
  "characterRules": {
    "successRequiresVerification": true,
    "successOnlyFrom": "EXECUTING",
    "sleepExitEvents": [
      "WAKE",
      "CONNECTION_LOST"
    ],
    "disconnectedExitEvents": [
      "CONNECTION_RESTORED",
      "SLEEP"
    ]
  },
  "characterTestVectors": [
    {
      "from": "IDLE",
      "event": "MIC_STARTED",
      "expect": "LISTENING"
    },
    {
      "from": "LISTENING",
      "event": "REQUEST_RECEIVED",
      "expect": "THINKING"
    },
    {
      "from": "THINKING",
      "event": "SPEECH_STARTED",
      "expect": "SPEAKING"
    },
    {
      "from": "SPEAKING",
      "event": "SPEECH_ENDED",
      "expect": "IDLE"
    },
    {
      "from": "THINKING",
      "event": "TASK_STARTED",
      "expect": "EXECUTING"
    },
    {
      "from": "EXECUTING",
      "event": "TASK_VERIFIED",
      "verified": true,
      "expect": "SUCCESS"
    },
    {
      "from": "EXECUTING",
      "event": "TASK_VERIFIED",
      "verified": false,
      "expect": "EXECUTING",
      "rejected": true
    },
    {
      "from": "THINKING",
      "event": "TASK_VERIFIED",
      "verified": true,
      "expect": "THINKING",
      "rejected": true
    },
    {
      "from": "EXECUTING",
      "event": "TASK_FAILED",
      "expect": "ERROR"
    },
    {
      "from": "SLEEPING",
      "event": "MIC_STARTED",
      "expect": "SLEEPING",
      "rejected": true
    },
    {
      "from": "SLEEPING",
      "event": "WAKE",
      "expect": "IDLE"
    },
    {
      "from": "SLEEPING",
      "event": "MIC_STOPPED",
      "expect": "SLEEPING",
      "rejected": true
    },
    {
      "from": "SLEEPING",
      "event": "RESET",
      "expect": "SLEEPING",
      "rejected": true
    },
    {
      "from": "DISCONNECTED",
      "event": "RESET",
      "expect": "DISCONNECTED",
      "rejected": true
    },
    {
      "from": "DISCONNECTED",
      "event": "SLEEP",
      "expect": "SLEEPING"
    },
    {
      "from": "SPEAKING",
      "event": "CONNECTION_LOST",
      "expect": "DISCONNECTED"
    },
    {
      "from": "DISCONNECTED",
      "event": "TASK_STARTED",
      "expect": "DISCONNECTED",
      "rejected": true
    },
    {
      "from": "DISCONNECTED",
      "event": "CONNECTION_RESTORED",
      "expect": "IDLE"
    },
    {
      "from": "LISTENING",
      "event": "SPEECH_STARTED",
      "expect": "LISTENING",
      "rejected": true
    },
    {
      "from": "THINKING",
      "event": "CLARIFICATION_NEEDED",
      "expect": "CONFUSED"
    },
    {
      "from": "THINKING",
      "event": "APPROVAL_REQUIRED",
      "expect": "CONCERNED"
    },
    {
      "from": "CONCERNED",
      "event": "TASK_STARTED",
      "expect": "EXECUTING"
    },
    {
      "from": "ERROR",
      "event": "RESET",
      "expect": "IDLE"
    },
    {
      "from": "CONFUSED",
      "event": "APPROVAL_REQUIRED",
      "expect": "CONCERNED"
    },
    {
      "from": "SUCCESS",
      "event": "APPROVAL_REQUIRED",
      "expect": "CONCERNED"
    },
    {
      "from": "ERROR",
      "event": "CLARIFICATION_NEEDED",
      "expect": "CONFUSED"
    },
    {
      "from": "LISTENING",
      "event": "APPROVAL_REQUIRED",
      "expect": "LISTENING",
      "rejected": true
    }
  ],
  "taskStates": [
    "REQUESTED",
    "PLANNED",
    "AWAITING_APPROVAL",
    "RUNNING",
    "VERIFYING",
    "COMPLETED",
    "FAILED",
    "CANCELLED"
  ],
  "taskTransitions": {
    "REQUESTED": [
      "PLANNED",
      "FAILED",
      "CANCELLED"
    ],
    "PLANNED": [
      "AWAITING_APPROVAL",
      "RUNNING",
      "FAILED",
      "CANCELLED"
    ],
    "AWAITING_APPROVAL": [
      "RUNNING",
      "FAILED",
      "CANCELLED"
    ],
    "RUNNING": [
      "AWAITING_APPROVAL",
      "VERIFYING",
      "FAILED",
      "CANCELLED"
    ],
    "VERIFYING": [
      "COMPLETED",
      "FAILED",
      "CANCELLED"
    ],
    "COMPLETED": [],
    "FAILED": [],
    "CANCELLED": []
  },
  "messages": {
    "clientToServer": {
      "hello": {
        "required": {
          "protocol": "int",
          "minProtocol": "int",
          "client": "str"
        },
        "optional": {
          "appVersion": "str",
          "deviceId": "str"
        }
      },
      "pair.request": {
        "required": {
          "code": "str",
          "deviceId": "str",
          "deviceName": "str"
        }
      },
      "auth.response": {
        "required": {
          "deviceId": "str",
          "mac": "str"
        }
      },
      "user.text": {
        "required": {
          "text": "str"
        },
        "optional": {
          "source": "str",
          "speakReply": "bool"
        }
      },
      "voice.state": {
        "required": {
          "state": "str"
        },
        "optional": {
          "level": "float"
        }
      },
      "approval.respond": {
        "required": {
          "approvalId": "str",
          "approve": "bool"
        }
      },
      "task.cancel": {
        "required": {
          "taskId": "str"
        }
      },
      "estop.trigger": {
        "required": {},
        "optional": {
          "reason": "str"
        }
      },
      "sleep.set": {
        "required": {
          "sleeping": "bool"
        }
      },
      "history.request": {
        "required": {},
        "optional": {
          "limit": "int"
        }
      },
      "ping": {
        "required": {},
        "optional": {
          "t": "int"
        }
      }
    },
    "serverToClient": {
      "hello.ack": {
        "required": {
          "protocol": "int",
          "server": "str"
        },
        "optional": {
          "serverVersion": "str"
        }
      },
      "auth.challenge": {
        "required": {
          "nonce": "str"
        }
      },
      "auth.ok": {
        "required": {
          "deviceId": "str"
        }
      },
      "pair.ok": {
        "required": {
          "deviceId": "str",
          "deviceKey": "str"
        }
      },
      "error": {
        "required": {
          "code": "str",
          "message": "str"
        },
        "optional": {
          "replyTo": "str",
          "fatal": "bool"
        }
      },
      "character.state": {
        "required": {
          "state": "str"
        },
        "optional": {
          "reason": "str",
          "taskId": "str"
        }
      },
      "connection.status": {
        "required": {
          "status": "str"
        },
        "optional": {
          "devices": "int",
          "llm": "str",
          "model": "str",
          "build": "str",
          "buildStale": "bool"
        }
      },
      "voice.state": {
        "required": {
          "state": "str"
        },
        "optional": {
          "level": "float",
          "source": "str"
        }
      },
      "assistant.message": {
        "required": {
          "text": "str",
          "messageId": "str"
        },
        "optional": {
          "speak": "bool",
          "taskId": "str",
          "role": "str"
        }
      },
      "task.update": {
        "required": {
          "taskId": "str",
          "status": "str",
          "title": "str"
        },
        "optional": {
          "kind": "str",
          "step": "str",
          "progress": "float",
          "detail": "str"
        }
      },
      "task.result": {
        "required": {
          "taskId": "str",
          "status": "str",
          "summary": "str"
        },
        "optional": {
          "verified": "bool",
          "artifacts": "list"
        }
      },
      "approval.request": {
        "required": {
          "approvalId": "str",
          "taskId": "str",
          "summary": "str",
          "risk": "str"
        },
        "optional": {
          "remoteAllowed": "bool",
          "expiresAt": "int"
        }
      },
      "estop.state": {
        "required": {
          "engaged": "bool"
        },
        "optional": {
          "reason": "str"
        }
      },
      "sleep.state": {
        "required": {
          "sleeping": "bool"
        }
      },
      "history": {
        "required": {
          "messages": "list"
        }
      },
      "pong": {
        "required": {},
        "optional": {
          "t": "int"
        }
      },
      "cursor.update": {
        "required": {
          "x": "float",
          "y": "float",
          "displayId": "int",
          "displayWidth": "int",
          "displayHeight": "int"
        },
        "optional": {
          "vx": "float",
          "vy": "float",
          "scale": "float",
          "seq": "int"
        },
        "since": 2
      },
      "gaze.target": {
        "required": {
          "kind": "str",
          "x": "float",
          "y": "float"
        },
        "optional": {
          "vx": "float",
          "vy": "float",
          "displayId": "int",
          "label": "str",
          "confidence": "float",
          "durationMs": "int",
          "pointId": "str",
          "seq": "int"
        },
        "since": 2
      },
      "research.result": {
        "required": {
          "taskId": "str",
          "query": "str",
          "summary": "str",
          "sources": "list"
        },
        "optional": {
          "summaryKind": "str"
        },
        "since": 2
      }
    }
  },
  "voiceStates": [
    "idle",
    "listening",
    "transcribing",
    "speaking",
    "unavailable"
  ],
  "errorCodes": [
    "bad_json",
    "too_large",
    "bad_envelope",
    "unknown_type",
    "bad_payload",
    "version_unsupported",
    "unauthenticated",
    "auth_failed",
    "pair_failed",
    "pair_locked",
    "rate_limited",
    "forbidden",
    "estop_engaged",
    "not_found",
    "internal"
  ],
  "versionNotes": {
    "1": "initial protocol",
    "2": "adds cursor.update, gaze.target and research.result (server->client); sent only to clients that negotiate v2"
  },
  "gazeKinds": [
    "element",
    "cursor",
    "clear"
  ]
}
