{
  "name": "baymax-visual-spec",
  "version": 2,
  "notes": "Single source of truth for the Mac (React SVG) and iPhone (SwiftUI shapes) companion. The character is flat 2D vector art: a white rounded head with two black oval eyes joined by a thin line on a deep burgundy stage. No 3D model, camera or scene exists on either platform. Both renderers build the same face from face2d with the same math (desktop/src/shared/face2d.ts, ios/BaymaxKit/Sources/BaymaxKit/Face2D.swift), checked against face2dTestVectors and expressionTestVectors.",
  "colors": {
    "background": "#180509",
    "accent": "#B5122A",
    "highlight": "#FF334F",
    "surface": "#080305",
    "text": "#F5F5F2",
    "skin": "#F5F5F2",
    "face": "#121214",
    "panel": "#14090C",
    "muted": "#C9A9AE",
    "stageTop": "#1F060C",
    "stageHalo": "#3A0A14",
    "stageMid": "#24070D",
    "ok": "#4CC38A",
    "warn": "#F2B84B",
    "error": "#FF5D6C"
  },
  "stage": {
    "description": "Deep crimson room: vertical gradient stageTop -> background -> surface, a dark halo from the top, and a soft red glow behind the head.",
    "glowCenter": {
      "x": 0.5,
      "y": 0.36
    },
    "glowOpacity": 0.22,
    "accentOpacity": 0.1
  },
  "typography": {
    "family": "SF Pro (system): -apple-system on the Mac, .system on iOS",
    "sizes": {
      "caption": 12,
      "body": 14,
      "status": 13,
      "title": 17
    },
    "weights": {
      "body": 400,
      "status": 500,
      "title": 600
    }
  },
  "spacing": {
    "unit": 4,
    "gutter": 16,
    "radius": 14,
    "controlHeight": 44
  },
  "states": {
    "IDLE": "slow breathing, occasional blink, gaze follows the Mac cursor when streamed",
    "LISTENING": "leans in slightly, head tilts, glow pulses with the real microphone level",
    "THINKING": "head tilts up and aside, eyes drift, slow glow",
    "SPEAKING": "gentle head nods synced to speech activity, glow follows TTS",
    "EXECUTING": "focused forward pose, steady glow while a task runs",
    "SUCCESS": "small happy bounce and arm lift, then back to idle",
    "CONFUSED": "head tilt and shrug; used when a request is ambiguous",
    "CONCERNED": "head lowers, arms close; approvals, permissions, emergency stop",
    "SLEEPING": "eyes closed, dimmed, very slow breathing; cursor, mic and listeners paused",
    "ERROR": "brief recoil, red glow, then calm",
    "DISCONNECTED": "dimmed, eyes half-closed, looking down",
    "TRACKING": "IDLE while real cursor samples arrive: eyes follow the cursor",
    "RESEARCHING": "a research task is running: eyes up, magnifier indicator",
    "POINTING": "a verified screen target: eyes and head turn to it, chevron and target lock point at it"
  },
  "face2d": {
    "units": "face units: origin at the head centre, x right, y down, head half-width = 1",
    "head": {
      "rx": 1,
      "ry": 0.74,
      "breatheGain": 0.6
    },
    "eye": {
      "x": 0.36,
      "y": 0,
      "rx": 0.105,
      "ry": 0.13,
      "minOpen": 0.012,
      "margin": 0.08
    },
    "line": {
      "thickness": 0.024
    },
    "travel": {
      "x": 0.3,
      "y": 0.2,
      "yawFollow": 0.25,
      "pitchFollow": 0.15
    },
    "foreshorten": {
      "width": 0.28,
      "spacing": 0.1
    },
    "parallax": {
      "yaw": 0.12,
      "pitch": 0.1,
      "body": 1.5
    },
    "pointer": {
      "radius": 1.1
    },
    "fit": {
      "widthFrac": 0.7,
      "heightFrac": 0.56,
      "centerY": 0.42,
      "parallaxRoom": 0.08,
      "description": "Whole head. Portrait/narrow: centred at centerY. Landscape without the dome (Mac companion): head ~87% of the height, centred. The iPhone uses the dome composition in landscape.",
      "landscapeHeightFrac": 0.94,
      "landscapeCenterY": 0.5
    },
    "shading": {
      "description": "Head: radial gradient from skin (upper-left highlight) to skinShade at the rim, plus a soft drop shadow. Eyes: flat face color with a tiny highlight. Stage: radial burgundy glow behind the head.",
      "skin": "#F7F6F3",
      "skinShade": "#D9D4D2",
      "rimShade": "#B9AFAF",
      "shadow": "#0A0204",
      "eyeHighlight": "#3A3A40",
      "highlightCenter": [
        -0.35,
        -0.45
      ],
      "shadowOffset": [
        0,
        0.08
      ],
      "shadowBlur": 0.12
    },
    "expressions": {
      "CONFUSED": {
        "eyeScaleR": 0.82
      },
      "CONCERNED": {
        "eyeScaleL": 0.94,
        "eyeScaleR": 0.94
      }
    },
    "indicators": {
      "TRACKING": "no glyph: the eyes follow the real cursor",
      "LISTENING": "ring around the head that pulses with the real microphone level",
      "THINKING": "three soft dots above the head",
      "RESEARCHING": "magnifier glyph orbiting the head while a research task runs",
      "EXECUTING": "progress arc around the head (task progress when reported)",
      "SPEAKING": "glow pulses with the speech envelope",
      "POINTING": "chevron at the head edge aimed at the target plus a target-lock reticle in that direction",
      "SLEEPING": "eyes closed to thin lines, stage dimmed, 'z' glyph",
      "ERROR": "red ring flash",
      "DISCONNECTED": "stage dimmed, eyes half closed, link-off glyph"
    },
    "dome": {
      "description": "Landscape desk-companion composition (like the reference device): the head is a dome rising from the bottom edge of the screen; only its upper part is visible and the eyes sit in it.",
      "halfWidthFrac": 0.47,
      "heightFrac": 0.86,
      "sink": 0.04,
      "eyeY": -0.36,
      "travelUp": 0.16,
      "travelDown": 0.1,
      "pointerMaxY": -0.12,
      "maxX": 0.22,
      "margin": 0.04
    },
    "bust": {
      "description": "Mac companion: the 2D head sitting on Baymax's round body with arms at the sides (flat vector shapes, no 3D). Face units, origin at the head centre, y down.",
      "headWidthFrac": 0.145,
      "headHeightFrac": 0.235,
      "headCenterY": 0.37,
      "body": {
        "neckY": 0.6,
        "neckHalfWidth": 0.72,
        "midY": 2.45,
        "midHalfWidth": 2.1,
        "bottomY": 3.6,
        "bottomHalfWidth": 2.3
      },
      "arm": {
        "x": 2.12,
        "top": 1.75,
        "width": 0.62,
        "height": 2.2,
        "radius": 0.31
      },
      "colors": {
        "body": "#EEEAE8",
        "bodyShade": "#CFC8C6",
        "arm": "#E2DDDB",
        "armShade": "#BDB5B3"
      }
    }
  },
